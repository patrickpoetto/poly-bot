# =============================================================================
# poly_bot — environment template (copy to .env and fill in)
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
POLY_BOT_ENV=development
POLY_BOT_LOG_LEVEL=INFO
POLY_BOT_LOG_JSON=false
POLY_BOT_DATA_DIR=./data
# Leave unset for SQLite (default). Set for Postgres production:
# DATABASE_URL=postgresql+psycopg://poly_bot:secret@localhost:5432/poly_bot
DATABASE_URL=

# Postgres (docker-compose.prod.yml)
POSTGRES_PASSWORD=changeme

# Production image (override to pin a published GHCR tag)
POLY_BOT_IMAGE=poly-bot:latest

# Backup sidecar
BACKUP_INTERVAL_SECONDS=3600
BACKUP_RETENTION_DAYS=7
RECONCILE_INTERVAL_SECONDS=3600

# -----------------------------------------------------------------------------
# Polymarket APIs
# -----------------------------------------------------------------------------
POLYMARKET_GAMMA_HOST=https://gamma-api.polymarket.com
POLYMARKET_DATA_HOST=https://data-api.polymarket.com
POLYMARKET_CLOB_HOST=https://clob.polymarket.com
POLYMARKET_WS_MARKET_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# -----------------------------------------------------------------------------
# Discovery engine
# -----------------------------------------------------------------------------
DISCOVERY_CLOSED_LOOKBACK_DAYS=7
DISCOVERY_FULL_SCAN_INTERVAL_MINUTES=30
DISCOVERY_DELTA_SCAN_INTERVAL_SECONDS=60
DISCOVERY_HTTP_CONCURRENCY=10
DISCOVERY_REQUEST_TIMEOUT_SECONDS=30.0
# Refresh series table on delta cycles (Gamma has no series updatedAt API)
DISCOVERY_SERIES_REFRESH_INTERVAL_MINUTES=10

# -----------------------------------------------------------------------------
# Live catalog (expiring window + real-time quotes)
# -----------------------------------------------------------------------------
CATALOG_EXPIRING_HOURS=6
CATALOG_SPORTS_IN_PLAY_HOURS=4
CATALOG_ENRICH_INTERVAL_SECONDS=60
CATALOG_ENRICH_ONLY_STALE=true
CATALOG_ENRICH_STALE_SECONDS=300
CATALOG_FETCH_OI=true
CATALOG_OI_CONCURRENCY=50
CATALOG_WS_ENABLED=true
CATALOG_WS_STALE_SECONDS=5.0
# Persistent WS daemon (24/7) — false reverts to per-cycle WS burst
CATALOG_WS_PERSISTENT=true
CATALOG_WS_REFRESH_SECONDS=120
CATALOG_WS_SHARD_SIZE=500
CATALOG_WS_MAX_SHARDS=16
CATALOG_DASHBOARD_HOST=127.0.0.1
CATALOG_DASHBOARD_PORT=8765
METRICS_ENABLED=false
METRICS_PORT=9090

# -----------------------------------------------------------------------------
# Wallet & chain (trading — optional until execution module)
# -----------------------------------------------------------------------------
PRIVATE_KEY=
WALLET_ADDRESS=
CHAIN_ID=137
RPC_URL=https://polygon-rpc.com

# -----------------------------------------------------------------------------
# CLOB API credentials (L2 — optional)
# -----------------------------------------------------------------------------
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# -----------------------------------------------------------------------------
# Builder API (optional)
# -----------------------------------------------------------------------------
BUILDER_API_KEY=
BUILDER_SECRET=
BUILDER_PASSPHRASE=

# -----------------------------------------------------------------------------
# Telegram alerter (paged ops)
# -----------------------------------------------------------------------------
# 1. Create a bot via @BotFather → /newbot → copy the token here.
# 2. Send any message to your new bot in Telegram, then run
#    `poly-bot ops telegram-chat-id` to discover TELEGRAM_CHAT_ID.
# 3. Set ALERTER_ENABLED=true to start the alerter sidecar.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
ALERTER_ENABLED=false
ALERTER_INTERVAL_SECONDS=60
ALERT_QUOTE_AGE_THRESHOLD=600
ALERT_DELTA_AGE_THRESHOLD=600
ALERT_RECONCILE_AGE_THRESHOLD=14400
